{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/asyazhao/meta-analysis-dual-coder/adjudication.schema.json",
  "title": "Third-party adjudication of one field-level disagreement",
  "type": "object",
  "required": [
    "independent_value",
    "independent_evidence",
    "verdict",
    "correct_value",
    "error_types",
    "severity",
    "rationale",
    "confidence"
  ],
  "additionalProperties": false,
  "properties": {
    "independent_value": {
      "type": [
        "string",
        "number",
        "null"
      ]
    },
    "independent_evidence": {
      "type": "object",
      "required": [
        "page",
        "quote"
      ],
      "additionalProperties": false,
      "properties": {
        "page": {
          "type": [
            "integer",
            "null"
          ]
        },
        "table": {
          "type": [
            "string",
            "null"
          ]
        },
        "quote": {
          "type": "string",
          "maxLength": 250
        }
      }
    },
    "verdict": {
      "enum": [
        "coder1_correct",
        "coder2_correct",
        "both_equivalent",
        "both_wrong",
        "source_ambiguous",
        "rule_gap",
        "needs_human"
      ]
    },
    "correct_value": {
      "type": [
        "string",
        "number",
        "null"
      ]
    },
    "error_types": {
      "type": "object",
      "properties": {
        "coder_1": {
          "type": "array",
          "items": {
            "enum": [
              "E01",
              "E02",
              "E03",
              "E04",
              "E05",
              "E06",
              "E07",
              "E08",
              "E09",
              "E10",
              "E11",
              "E12"
            ]
          }
        },
        "coder_2": {
          "type": "array",
          "items": {
            "enum": [
              "E01",
              "E02",
              "E03",
              "E04",
              "E05",
              "E06",
              "E07",
              "E08",
              "E09",
              "E10",
              "E11",
              "E12"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "severity": {
      "enum": [
        "critical",
        "major",
        "minor",
        "cosmetic"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "both_wrong"
          }
        }
      },
      "then": {
        "required": [
          "correct_value"
        ]
      }
    }
  ]
}
