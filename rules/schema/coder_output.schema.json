{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/asyazhao/meta-analysis-dual-coder/coder_output.schema.json",
  "title": "Coder output for one article",
  "type": "object",
  "required": [
    "article_key",
    "records"
  ],
  "additionalProperties": false,
  "properties": {
    "article_key": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "record_id",
          "article_key",
          "source_file",
          "sheet",
          "block_id",
          "sex",
          "fields",
          "provenance",
          "flags",
          "record_status"
        ],
        "additionalProperties": false,
        "properties": {
          "record_id": {
            "type": "string",
            "minLength": 1
          },
          "article_key": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "source_file": {
            "type": "string",
            "minLength": 1
          },
          "sheet": {
            "enum": [
              "WBIS",
              "WSSQ"
            ]
          },
          "block_id": {
            "type": "string",
            "pattern": "^b[0-9]{2,}$"
          },
          "sex": {
            "enum": [
              0,
              1,
              2
            ]
          },
          "fields": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "full_reference",
              "subsample_label",
              "source_type",
              "paper_id",
              "sex",
              "country",
              "sample_type",
              "clinical_type",
              "sampling_method",
              "publication_year",
              "year_data_collection",
              "year_imputed_rule",
              "sample_n",
              "mean_age",
              "age_calculation",
              "age_group",
              "mean_bmi",
              "measure_name",
              "translated_flag",
              "scale_comparable_flag",
              "items_n",
              "response_scale_min",
              "response_scale_max",
              "direction",
              "scale_total",
              "scale_mean",
              "scale_sd",
              "mean_calculation"
            ],
            "properties": {
              "full_reference": {
                "type": "string"
              },
              "subsample_label": {
                "type": "string"
              },
              "source_type": {
                "enum": [
                  1,
                  2,
                  3,
                  4
                ]
              },
              "paper_id": {
                "type": "integer"
              },
              "sex": {
                "enum": [
                  0,
                  1,
                  2
                ]
              },
              "country": {
                "type": "string"
              },
              "sample_type": {
                "enum": [
                  1,
                  2,
                  3,
                  4
                ]
              },
              "clinical_type": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "sampling_method": {
                "enum": [
                  1,
                  2
                ]
              },
              "publication_year": {
                "type": "integer",
                "minimum": 1900,
                "maximum": 2035
              },
              "year_data_collection": {
                "type": "integer",
                "minimum": 1900,
                "maximum": 2035
              },
              "year_imputed_rule": {
                "enum": [
                  1,
                  2,
                  3
                ]
              },
              "sample_n": {
                "type": "integer",
                "minimum": 1
              },
              "mean_age": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "const": -999
                  }
                ]
              },
              "age_calculation": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "age_group": {
                "enum": [
                  1,
                  2,
                  3,
                  4,
                  -999
                ]
              },
              "mean_bmi": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "const": -999
                  }
                ]
              },
              "measure_name": {
                "type": "string"
              },
              "translated_flag": {
                "enum": [
                  1,
                  2
                ]
              },
              "scale_comparable_flag": {
                "enum": [
                  1,
                  2,
                  3
                ]
              },
              "items_n": {
                "type": "integer",
                "minimum": 1
              },
              "response_scale_min": {
                "type": "integer"
              },
              "response_scale_max": {
                "type": "integer"
              },
              "direction": {
                "enum": [
                  1,
                  2
                ]
              },
              "scale_total": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "scale_mean": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "const": -999
                  }
                ]
              },
              "scale_sd": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "const": -999
                  }
                ]
              },
              "mean_calculation": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "provenance": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": [
                "page",
                "quote"
              ],
              "properties": {
                "page": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "table": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "quote": {
                  "type": "string",
                  "maxLength": 250
                }
              }
            }
          },
          "flags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "record_status": {
            "enum": [
              "coded",
              "missing_statistics",
              "not_eligible",
              "eligibility_unresolved",
              "source_unreadable",
              "source_incomplete",
              "overlap_unresolved"
            ]
          }
        }
      }
    },
    "escalations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "reason"
        ],
        "properties": {
          "reason": {
            "type": "string"
          },
          "pages": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "article_status": {
      "enum": [
        "coded",
        "missing_statistics",
        "not_eligible",
        "eligibility_unresolved",
        "source_unreadable",
        "source_incomplete",
        "overlap_unresolved"
      ]
    },
    "notes": {
      "type": "string"
    }
  }
}
